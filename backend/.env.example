# ---------------------------------------------------------------
# UrbanNest API configuration
# Copy this file to backend/.env and fill in your own values.
# ---------------------------------------------------------------

# Required
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/urbannest
JWT_SECRET=replace-with-a-long-random-string

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (production)
CLIENT_URL=http://localhost:5173

# Auth cookie SameSite policy: strict | lax | none
# Use "none" when the frontend and API are on different domains (HTTPS only)
COOKIE_SAME_SITE=strict

# Admin account used by `npm run create-admin`
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_PHONE=+8801000000000
